---
import PlotFigure from "./PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import { penguinIcon, speciesColors } from "../utils/penguins.js";

const { species } = Astro.props;
const filtered = penguins.filter((p) => p.species === species);
const icon = penguinIcon(speciesColors[species]);
---

<PlotFigure
  options={{
    marks: [
      Plot.image(filtered, {
        x: "culmen_length_mm",
        y: "culmen_depth_mm",
        src: () => icon,
        width: 20,
        height: 20,
      }),
    ],
  }}
/>
