---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Établissements d'enseignement supérieur">
  <h1 class="text-2xl">TP LeafLet.JS - Établissements d'enseignement supérieur</h1>
  <p>
    Implantations des établissements publics (source : data.enseignementsup-recherche.gouv.fr).
  </p>
  <div id="map" class="h-[600px] w-full"></div>

  <script>
    import L from "leaflet";
    import "leaflet/dist/leaflet.css";
    import etablissements from "../../assets/etablissements.json";

    // Carte centrée sur la France, rendu canvas pour afficher beaucoup de points
    const map = L.map("map", { preferCanvas: true }).setView([46.6, 2.5], 6);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // Un point par établissement, avec son nom dans une popup
    for (const etab of etablissements) {
      L.circleMarker([etab.lat, etab.lon], {
        radius: 5,
        color: "#1d4ed8",
        fillOpacity: 0.6,
      })
        .bindPopup(etab.name)
        .addTo(map);
    }
  </script>
</Layout>
