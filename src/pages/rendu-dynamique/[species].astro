---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";
import { penguinIcon, speciesColors } from "../../utils/penguins.js";

const { species } = Astro.params;
// Filtrer les manchots pour l'espèce demandée
const filtered = penguins.filter((p) => p.species === species);
if (filtered.length === 0) return Astro.redirect("/rendu-dynamique");

const icon = penguinIcon(speciesColors[species as keyof typeof speciesColors]);
---

<Layout title={`Manchots ${species}`}>
  <h1 class="text-2xl">Manchots {species} (rendu dynamique)</h1>
  <p>{filtered.length} manchot(s) trouvé(s)</p>
  <PlotFigure
    options={{
      grid: true,
      x: { label: "Longueur du bec (mm)" },
      y: { label: "Profondeur du bec (mm)" },
      marks: [
        Plot.image(filtered, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          src: () => icon,
          width: 20,
          height: 20,
        }),
      ],
    }}
  />
  <a class="text-blue-600 underline" href="/rendu-dynamique">← Retour</a>
</Layout>
