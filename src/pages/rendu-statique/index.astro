---
import Layout from "../../layouts/Layout.astro";
import penguins from "../../assets/penguins.json";

// Liste des espèces générée automatiquement
const species = [...new Set(penguins.map((p) => p.species))].sort();
---

<Layout title="Rendu statique">
  <h1 class="text-2xl mb-4">Espèces (rendu statique)</h1>
  <ul class="list-disc pl-6">
    {
      species.map((s) => (
        <li>
          <a class="text-blue-600 underline" href={`/rendu-statique/${s}`}>
            {s}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
