---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";
import { penguinIcon, speciesColors } from "../../utils/penguins.js";

// Génère une page par espèce au moment du build
export function getStaticPaths() {
  const species = [...new Set(penguins.map((p) => p.species))];
  return species.map((s) => ({
    params: { species: s },
    props: { filtered: penguins.filter((p) => p.species === s) },
  }));
}

const { species } = Astro.params;
const { filtered } = Astro.props;
const icon = penguinIcon(speciesColors[species as keyof typeof speciesColors]);
---

<Layout title={`Manchots ${species}`}>
  <h1 class="text-2xl">Manchots {species} (rendu statique)</h1>
  <p>{filtered.length} manchot(s) trouvé(s)</p>
  <PlotFigure
    options={{
      grid: true,
      x: { label: "Longueur du bec (mm)" },
      y: { label: "Profondeur du bec (mm)" },
      marks: [
        Plot.image(filtered, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          src: () => icon,
          width: 20,
          height: 20,
        }),
      ],
    }}
  />
  <a class="text-blue-600 underline" href="/rendu-statique">← Retour</a>
</Layout>
