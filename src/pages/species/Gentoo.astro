---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";
import { penguinIcon, speciesColors } from "../../utils/penguins.js";

const penguinsGentoo = penguins.filter(({ species }) => species === "Gentoo");
const icon = penguinIcon(speciesColors.Gentoo);
---

<Layout title="Gentoo">
  <h1>Manchots Gentoo</h1>
  <PlotFigure
    options={{
      marks: [
        Plot.image(penguinsGentoo, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          src: () => icon,
          width: 20,
          height: 20,
        }),
      ],
    }}
  />
</Layout>
