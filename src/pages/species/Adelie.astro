---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";
import { penguinIcon, speciesColors } from "../../utils/penguins.js";

const penguinsAdelie = penguins.filter(({ species }) => species === "Adelie");
const icon = penguinIcon(speciesColors.Adelie);
---

<Layout title="Adelie">
  <h1>Manchots Adelie</h1>
  <PlotFigure
    options={{
      marks: [
        Plot.image(penguinsAdelie, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          src: () => icon,
          width: 20,
          height: 20,
        }),
      ],
    }}
  />
</Layout>
